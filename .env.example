# --- Data sources ---
# Finnhub (https://finnhub.io/) — primary source as of Phase 1B migration.
# Free tier: 60 calls/minute, no daily cap. Sign up at finnhub.io and paste the key here.
FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep — legacy/optional. Only used if you explicitly
# retain the FMP code path. Free tier: 250 calls/day.
FMP_API_KEY=your_fmp_api_key_here

# FRED (Federal Reserve Economic Data) — macro context for Economist agent.
# Free, unlimited. Register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# --- Telegram notification (optional) ---
# 1. Create a bot via @BotFather on Telegram, copy the token.
# 2. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to extract your chat_id from the response.
# 3. Fill both values below. Leave blank to disable push notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (default backend: Ollama, local) ---
OLLAMA_HOST=http://localhost:11434

# Model assignment per agent (legacy path — still authoritative when
# config/agent_models.yaml leaves an agent block empty, which is the
# default seed). Keep these set so a `git pull` doesn't change your
# model selection.
ANALYST_MODEL=llama3.1:8b
VALUER_MODEL=llama3.1:8b
SKEPTIC_MODEL=qwen2.5:7b
STEWARD_MODEL=qwen2.5:7b

# Phase 5: sampling now follows each model's recommended config (Qwen
# 2.5 → temp 0.7 / top_p 0.8; Qwen3 thinking → 0.6 / 0.95 / min_p 0;
# Llama 3.x → 0.7 / 0.9). Re-enable deterministic mode by adding a
# `sampling: { temperature: 0, seed: 42 }` block to a specific agent
# in `config/agent_models.yaml` — see docs/llm_backends.md.
# These two keys are kept for backwards compatibility but no longer
# drive the default path.
LLM_TEMPERATURE=0.0
LLM_SEED=42

# --- Alternative LLM backend (optional) ---
# Default is Ollama. Switch to one of the alternatives below by
# setting LLM_BACKEND. See docs/llm_backends.md for hardware-specific
# guidance and example agent_models.yaml configs.
#
# LLM_BACKEND=ollama          # default
# LLM_BACKEND=openai_compat   # vLLM, LM Studio, Ollama /v1, mlx_lm.server, …
# LLM_BACKEND=mlx             # Apple Silicon native
# LLM_BACKEND=llamacpp        # GGUF via llama-cpp-python

# OpenAI-compatible HTTP backend (vLLM / LM Studio / mlx_lm.server / etc.)
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_API_KEY=local

# MLX (Apple Silicon only) — install with `pip install mafis[mlx]`
# MLX_MODEL_CACHE_DIR=~/.cache/huggingface/hub

# llama.cpp — install with `pip install mafis[llamacpp]` for CPU,
# or with CMAKE_ARGS for GPU builds (see docs/llm_backends.md).
# LLAMACPP_MODEL_PATH=/path/to/Qwen2.5-7B-Instruct-Q4_K_M.gguf
# LLAMACPP_N_GPU_LAYERS=-1
# LLAMACPP_N_CTX=8192

# --- Storage ---
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_PATH=./data/portfolio.sqlite
